      <div class="bg-[#05070e] border border-slate-800 rounded-xl p-5 shadow-2xl overflow-x-auto text-xs text-slate-300 font-mono">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800 text-slate-500">
          <span>agent_runtime.py</span>
          <span>Python 3.11</span>
        </div>
<pre><span class="text-purple-400">import</span> voxforge <span class="text-purple-400">as</span> vf
<span class="text-purple-400">from</span> voxforge.agents <span class="text-purple-400">import</span> VoiceAgent, RealtimeConfig

<span class="text-slate-500"># Configure real-time voice inference pipeline</span>
agent = VoiceAgent(
    name=<span class="text-emerald-300">"enterprise-support-tier1"</span>,
    model=<span class="text-emerald-300">"gpt-4o-realtime-preview"</span>,
    voice=<span class="text-emerald-300">"verse"</span>,
    instructions=<span class="text-emerald-300">"Assist customers with enterprise billing and support queries."</span>,
    tools=[vf.tools.LookupAccount, vf.tools.ScheduleDispatch],
    config=RealtimeConfig(
        vad_sensitivity=<span class="text-amber-400">0.85</span>,
        max_turn_delay_ms=<span class="text-amber-400">300</span>,
        temperature=<span class="text-amber-400">0.6</span>
    )
)

<span class="text-slate-500"># Bind agent directly to incoming SIP telephony channel</span>
vf.telephony.attach_trunk(
    trunk_id=<span class="text-emerald-300">"sip_us_east_primary"</span>, 
    active_agent=agent
)
<span class="text-cyan-400">print</span>(<span class="text-emerald-300">"Agent live and streaming..."</span>)</pre>
